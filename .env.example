# API
BUKMATIKA_CONTACT_EMAIL=
BUKMATIKA_WEB_ORIGIN=http://localhost:3000
BUKMATIKA_DATABASE_URL=postgresql+psycopg://bukmatika:bukmatika@localhost:5432/bukmatika
BUKMATIKA_LOG_LEVEL=INFO

# Local AI generation (fail-closed unless explicitly enabled with a real local model)
BUKMATIKA_MODEL_PROVIDER=none
BUKMATIKA_OLLAMA_BASE_URL=http://127.0.0.1:11434
BUKMATIKA_OLLAMA_MODEL=
BUKMATIKA_MODEL_TIMEOUT_SECONDS=45
BUKMATIKA_MODEL_READINESS_TIMEOUT_SECONDS=2.5

# Optional local semantic retrieval (explicit only; lexical search remains PostgreSQL-only)
BUKMATIKA_EMBEDDING_PROVIDER=none
BUKMATIKA_OLLAMA_EMBEDDING_MODEL=
BUKMATIKA_EMBEDDING_TIMEOUT_SECONDS=30
BUKMATIKA_SEMANTIC_SEARCH_MAX_CHUNKS=256
BUKMATIKA_SEMANTIC_SEARCH_BATCH_SIZE=24

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
