# Canonical self-hosted deployment settings.
# Create .env.production with: python scripts/deploy.py init
# The deploy command generates a strong database password and never overwrites an existing file.

# The production ingress binds to loopback by default. Put your TLS reverse proxy in front of it
# for remote access; do not expose this plain-HTTP port directly to an untrusted network.
BUKMATIKA_BIND_ADDRESS=127.0.0.1
BUKMATIKA_HTTP_PORT=8080
BUKMATIKA_PUBLIC_ORIGIN=http://127.0.0.1:8080
BUKMATIKA_LOCAL_SESSION_SECURE_COOKIE=false

# Replaced automatically by scripts/deploy.py. Keep values URL-safe because the secret is also
# used inside the internal PostgreSQL connection URI.
BUKMATIKA_POSTGRES_PASSWORD=GENERATE_ME

BUKMATIKA_LOG_LEVEL=INFO
BUKMATIKA_CONTACT_EMAIL=
BUKMATIKA_IMAGE_TAG=local

# Containerized local AI is intentionally disabled. Bukmatika's Ollama adapters accept loopback
# only; crossing the container boundary requires a separately reviewed local transport design.
BUKMATIKA_MODEL_PROVIDER=none
BUKMATIKA_EMBEDDING_PROVIDER=none
